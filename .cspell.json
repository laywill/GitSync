{
    "version": "0.2",
    "language": "en-GB",
    "allowCompoundWords": true,
    "import": [
        "@cspell/dict-de-de/cspell-ext.json",
        "@cspell/dict-ru_ru/cspell-ext.json"
    ],
    "dictionaries": [
        "bash",
        "companies",
        "dart",
        "en-GB",
        "en_US",
        "filetypes",
        "flutter",
        "fonts",
        "markdown",
        "misc",
        "powershell",
        "rust",
        "softwareTerms"
    ],
    "flagWords": [
        "hte"
    ],
    "words": [
        "GitSync",
        "GITEA",
        "sdcard",
        "webp",
        "pbxproj",
        "xcodeproj",
        "xcworkspace",
        "fvmrc",
        "desugar",
        "cdylib",
        "vendored",
        "xxxhdpi",
        "Izzy",
        "osascript",
        "documentsui",
        "Cred",
        "osshkeys",
        "unpulled",
        "unpushed",
        "wline",
        "fcntl",
        "EWOULDBLOCK",
        "oids",
        "msgnum",
        "Nodelete",
        "Gitea",
        "Accessibility"
    ],
    "ignoreWords": [
        "anys",
        "kinded",
        "vars",
        "lineageos",
        "notif",
        "stls",
        "xcassets",
        "Recents",
        "efgh",
        "obsi",
        "youre",
        "Repro",
        "specfic",
        "analyzer",
        "analyzes",
        "behavior",
        "favor",
        "defenses",
        "Dialogs",
        "dialog",
        "linters",
        "DARTANALYZER",
        "KTLINT"
    ],
    "ignorePaths": [
        "rust_builder/cargokit/**",
        "notes.md",
        "task_plan.md"
    ],
    "overrides": [
        {
            "filename": "fastlane/metadata/android/de/**",
            "language": "de-DE",
            "dictionaries": ["de-de"],
            "words": ["Barrierefreiheitsdienstes"]
        },
        {
            "filename": "fastlane/metadata/android/ru/**",
            "language": "ru",
            "dictionaries": ["ru-ru"],
            "words": ["коммита"]
        }
    ]
}
